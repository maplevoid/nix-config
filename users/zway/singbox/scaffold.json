{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns_proxy",
        "type": "tls",
        "server": "1.1.1.1",
        "detour": "🔰 节点选择"
      },
      {
        "tag": "dns_direct",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns_fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15"
      },
      {
        "tag": "ts-dns",
        "type": "udp",
        "server": "100.100.100.100",
        "detour": "ts-out"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "entry.fr0528.art",
          "entry.rtysjur.quest"
        ],
        "server": "dns_direct"
      },
      {
        "domain_suffix": [
          "ts.net"
        ],
        "server": "ts-dns"
      },
      {
        "clash_mode": "Global",
        "server": "dns_proxy"
      },
      {
        "clash_mode": "Direct",
        "server": "dns_direct"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns_fakeip"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "server": "dns_proxy"
      }
    ],
    "final": "dns_direct",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "10.201.0.1/30"
      ],
      "auto_route": true,
      "strict_route": true,
      "stack": "system",
      "interface_name": "tun0"
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "route": {
    "rule_set": [
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ads-all.srs",
        "download_detour": "🔰 节点选择"
      },
      {
        "tag": "geosite-geolocation-!cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-!cn.srs",
        "download_detour": "🔰 节点选择"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "download_detour": "🔰 节点选择"
      }
    ],
    "rules": [
      {
        "ip_cidr": [
          "100.64.0.0/10"
        ],
        "outbound": "ts-out"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Direct",
        "outbound": "DIRECT"
      },
      {
        "clash_mode": "Global",
        "outbound": "GLOBAL"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "outbound": "🛑 全球拦截"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "🔰 节点选择"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "🎯 全球直连"
      },
      {
        "ip_is_private": true,
        "outbound": "🎯 全球直连"
      }
    ],
    "auto_detect_interface": true,
    "final": "🐟 漏网之鱼",
    "default_domain_resolver": "dns_direct"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui"
    },
    "cache_file": {
      "enabled": true
    }
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      "type": "block",
      "tag": "REJECT"
    },
    {
      "type": "selector",
      "tag": "🎯 全球直连",
      "outbounds": [
        "DIRECT"
      ]
    }
  ]
}
